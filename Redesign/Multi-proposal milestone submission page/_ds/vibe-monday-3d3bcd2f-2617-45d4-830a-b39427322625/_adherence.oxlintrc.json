        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:normal|positive|negative|warning|dark)$/]",
        "message": "<Toast> type must be one of 'normal' | 'positive' | 'negative' | 'warning' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:content|children|position|theme|style|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: content, children, position, theme, style."
